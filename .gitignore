# Both forms. The trailing-slash pattern does NOT match a `node_modules`
# SYMLINK, which is what a git worktree gets when you link it to the canonical
# checkout's modules — and `git add -A` will then happily stage it.
node_modules/
node_modules
dist/
*.tsbuildinfo
coverage/
.nx/
.DS_Store
*.log

# Build output. Neither was ignored before, and neither is tracked on main —
# so a fresh checkout that runs a build and then `git add -A` stages several
# hundred generated files. That is how this file grew the entry.
.next/
styled-system/

# Self-host data. A committed SQLite file would carry someone's real EIN and
# filing history into a public repo.
*.sqlite
*.sqlite3
data/

# Playwright output.
apps/web/e2e/.artifacts/
playwright-report/
test-results/

# PRDs live in the INTERNAL stonedog-prd repo, never here — this repo is PUBLIC.
docs/prd
